{
  "name": "crewbtc",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny max-lines --max-warnings=0",
    "lint:types": "oxlint --type-aware --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gate:contrast": "node scripts/check-contrast.mjs",
    "gate:theme": "node scripts/check-theme.mjs .",
    "gate:layout": "node scripts/check-layout.mjs src",
    "gate:manifest": "node scripts/check-manifest.mjs public/manifest.json public",
    "gate:placeholders": "bash scripts/check-placeholders.sh",
    "gate:secrets": "bash scripts/check-secrets.sh",
    "gate:bundle": "bash scripts/check-bundle.sh",
    "gate": "npm run typecheck && npm run lint && npm run lint:types && npm run build && npm run test && npm run gate:contrast && npm run gate:theme && npm run gate:layout && npm run gate:manifest && npm run gate:placeholders && npm run gate:secrets && npm run gate:bundle"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.76.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
